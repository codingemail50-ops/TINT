<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base foreground-service permission (needed on API 28+) and the
         specialUse type permission (needed on API 34+) — this blocking
         service doesn't fit a predefined type like mediaPlayback/location,
         so it declares specialUse with the required justification property
         below, per Android 14's foreground-service-type requirements. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Not a permission (nothing for Play Console to review) — Android 11+
         package visibility: lets BlockingForegroundService look up which
         app(s) are the phone's home screen, since on gesture-nav phones the
         recents switcher lives inside the launcher. Only home-screen apps
         become visible, nothing else installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <service
            android:name="expo.modules.tintappblocker.BlockingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Blocks a small set of user-selected distracting apps while a focus session the user explicitly started in TINT is active. Runs only for the session's duration and stops automatically when the session's timer ends or the user explicitly ends it — deliberately keeps running even if the user swipes TINT away mid-session, since the session they started is still active." />
        </service>
    </application>

</manifest>
