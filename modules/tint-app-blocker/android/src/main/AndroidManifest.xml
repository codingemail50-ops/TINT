<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base foreground-service permission (needed on API 28+) and the
         specialUse type permission (needed on API 34+) — this blocking
         service doesn't fit a predefined type like mediaPlayback/location,
         so it declares specialUse with the required justification property
         below, per Android 14's foreground-service-type requirements. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Normal (non-sensitive) permission: lets a running 7-day challenge's
         blocking come back after the phone reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Not a permission (nothing for Play Console to review) — Android 11+
         package visibility: lets BlockingForegroundService look up which
         app(s) are the phone's home screen, since on gesture-nav phones the
         recents switcher lives inside the launcher. Only home-screen apps
         become visible, nothing else installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <service
            android:name="expo.modules.tintappblocker.BlockingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Blocks a small set of user-selected distracting apps while a focus session or a 7 Day Lock In challenge that the user explicitly started in TINT is active. A focus session runs for its timer. A challenge runs continuously for its 7 days, so the blocks hold even when TINT is not open on screen. While running it shows a persistent notification, and for a challenge it restarts after a phone reboot or if Android stops it. It stops automatically when the timer or challenge ends, or when the user ends it." />
        </service>
        <receiver
            android:name="expo.modules.tintappblocker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
