<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded version of notification_focus.xml: the same logo, title, countdown
    and control, plus the line that explains what the background service is
    doing (for example "Monitoring your selected apps to protect your focus
    streak.").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/tint_notification_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/notif_flame_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FCC268"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/notif_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#D8C8B8"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="Pause or resume" />
</LinearLayout>
